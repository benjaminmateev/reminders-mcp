{
  "name": "reminders-mcp",
  "version": "0.1.0",
  "description": "Small MCP server for Apple Reminders on macOS: list, search, create, complete.",
  "type": "module",
  "bin": {
    "reminders-mcp": "index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --format=cjs --minify --legal-comments=eof --outfile=dist/server.cjs",
    "pack": "npm run build && mcpb pack . reminders-mcp.mcpb"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "@anthropic-ai/mcpb": "2.1.2"
  }
}